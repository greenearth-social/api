{
  "displayName": "API Performance & Bottleneck Attribution (${ENV})",
  "dashboardFilters": [],
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "1 — Load & user experience",
          "sectionHeader": {
            "subtitle": "Whether users are getting a complete feed quickly right now. Traffic classes separate production users (real) from the synthetic uptime check (probe) and generated load (load_test). Probe and real rising together means users are affected; load_test alone rising means the system is absorbing the extra load.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 1,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Feed renders per minute by traffic class",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "success traffic=${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (traffic)(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.success_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "failed traffic=${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (traffic)(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "renders / min",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 1,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Feed render latency by traffic class",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 traffic=${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, traffic)(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p50 traffic=${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.5, sum by (le, traffic)(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 2500,
                "label": "p95 target (2,500 ms)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 1,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Failure, degradation and 5xx rate (% of renders)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "failed % of renders",
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * (sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)) / clamp_min((sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.success_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)) + (sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)), 0.0001)"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "degraded % of renders",
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * (sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.degraded_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)) / clamp_min((sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.success_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)) + (sum(rate({__name__=\"custom.googleapis.com/greenearth-api/feed.render.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])) or vector(0)), 0.0001)"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "5xx % of requests",
                "timeSeriesQuery": {
                  "prometheusQuery": "100 * (sum(rate({__name__=\"run.googleapis.com/request_count\", monitored_resource=\"cloud_run_revision\", service_name=\"greenearth-api-${ENV}\", response_code_class=\"5xx\"}[5m])) or vector(0)) / clamp_min(sum(rate({__name__=\"run.googleapis.com/request_count\", monitored_resource=\"cloud_run_revision\", service_name=\"greenearth-api-${ENV}\"}[5m])), 0.0001)"
                }
              }
            ],
            "thresholds": [
              {
                "value": 1,
                "label": "failure-rate goal (1%)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "% of renders",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 9,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "2 — Serving stages",
          "sectionHeader": {
            "subtitle": "Which stage of a feed render owns the latency. Each dependency is charted client-side (how long the api waited) against server-side (how long the dependency says it worked), so a gap between the pair is time spent queuing inside the api rather than a slow backend.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 10,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Candidate generation latency and failures per minute",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 generator=${metric.labels.generator_name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, generator_name)(rate({__name__=\"custom.googleapis.com/greenearth-api/candidates.generate.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y2",
                "legendTemplate": "failures/min generator=${metric.labels.generator_name} outcome=${metric.labels.outcome}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (generator_name, outcome)(rate({__name__=\"custom.googleapis.com/greenearth-api/candidates.generate.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "failures / min",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 10,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Ranking latency: api client-side vs inference server-side",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "api p95 model=${metric.labels.model_name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, model_name)(rate({__name__=\"custom.googleapis.com/greenearth-api/rank.model.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "inference p95 model=${metric.labels.model_name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, model_name)(rate({__name__=\"custom.googleapis.com/greenearth-inference/inference.predict.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 10,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Perspective scoring latency and failures per minute",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 duration",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le)(rate({__name__=\"custom.googleapis.com/greenearth-api/perspective.score.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p50 duration",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.5, sum by (le)(rate({__name__=\"custom.googleapis.com/greenearth-api/perspective.score.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y2",
                "legendTemplate": "failures/min status_code=${metric.labels.status_code}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (status_code)(rate({__name__=\"custom.googleapis.com/greenearth-api/perspective.score.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "failures / min",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 18,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "3 — API saturation & client-side queuing",
          "sectionHeader": {
            "subtitle": "Whether the api process itself is the bottleneck. Event-loop lag, CPU and instance count show saturation affecting every request; the in-flight charts show a single dependency's connection pool filling up. See the attribution playbook for how to tell them apart: https://github.com/greenearth-social/api/blob/main/monitoring/README.md",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 19,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Event-loop scheduling lag per instance",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 fleet-wide",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le)(rate({__name__=\"custom.googleapis.com/greenearth-api/eventloop.lag_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "p95 instance=${metric.labels.task_id}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, task_id)(rate({__name__=\"custom.googleapis.com/greenearth-api/eventloop.lag_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 100,
                "label": "saturation threshold (100 ms)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 19,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Cloud Run instances, CPU and memory utilization",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "instances state=${metric.labels.state}",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/instance_count\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"greenearth-api-${ENV}\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_MEAN",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": [
                        "metric.label.\"state\""
                      ]
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y2",
                "legendTemplate": "CPU p95",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/cpu/utilizations\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"greenearth-api-${ENV}\"",
                    "aggregation": {
                      "alignmentPeriod": "120s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": []
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y2",
                "legendTemplate": "memory p95",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"run.googleapis.com/container/memory/utilizations\" resource.type=\"cloud_run_revision\" resource.label.\"service_name\"=\"greenearth-api-${ENV}\"",
                    "aggregation": {
                      "alignmentPeriod": "120s",
                      "perSeriesAligner": "ALIGN_PERCENTILE_95",
                      "crossSeriesReducer": "REDUCE_MEAN",
                      "groupByFields": []
                    }
                  }
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "instances",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "utilization (0-1)",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 19,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Dependency failures per minute by cause",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "elasticsearch error=${metric.labels.error}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (error)(rate({__name__=\"custom.googleapis.com/greenearth-api/es.query.error_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "perspective status_code=${metric.labels.status_code}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (status_code)(rate({__name__=\"custom.googleapis.com/greenearth-api/perspective.score.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "bluesky follows status_code=${metric.labels.status_code}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (status_code)(rate({__name__=\"custom.googleapis.com/greenearth-api/bsky.follows.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "inference status_code=${metric.labels.status_code}",
                "timeSeriesQuery": {
                  "prometheusQuery": "60 * sum by (status_code)(rate({__name__=\"custom.googleapis.com/greenearth-api/rank.model.failure_count\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m]))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 1,
                "label": "expected ceiling (1/min)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "failures / min",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 27,
        "width": 6,
        "height": 8,
        "widget": {
          "title": "Outbound connection setup time by client",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "connect p95 client=${metric.labels.client}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, client)(rate({__name__=\"custom.googleapis.com/greenearth-api/client.connect.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 6,
        "yPos": 27,
        "width": 6,
        "height": 8,
        "widget": {
          "title": "Concurrent outbound requests in flight — httpx / ES capped at 100",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "in flight p95 host=${metric.labels.host}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, host)(rate({__name__=\"custom.googleapis.com/greenearth-api/client.in_flight_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "elasticsearch in flight p95 op=${metric.labels.op}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, op)(rate({__name__=\"custom.googleapis.com/greenearth-api/es.client.in_flight_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 100,
                "label": "httpx / ES pool cap (100)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "concurrent requests",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 35,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "4 — Elasticsearch",
          "sectionHeader": {
            "subtitle": "How much of each query's time Elasticsearch actually spent working. The cluster reports took; the difference between that and the api's measured duration is time the query spent queued client-side. Thread-pool queueing and rejections mean the cluster is at its own concurrency ceiling.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 36,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Elasticsearch query latency: api client-side vs cluster-reported",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "client duration p95 op=${metric.labels.op}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, op)(rate({__name__=\"custom.googleapis.com/greenearth-api/es.query.duration_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "cluster took p95 op=${metric.labels.op}",
                "timeSeriesQuery": {
                  "prometheusQuery": "histogram_quantile(0.95, sum by (le, op)(rate({__name__=\"custom.googleapis.com/greenearth-api/es.query.took_ms_bucket\", monitored_resource=\"generic_task\", namespace=\"${NAMESPACE}\"}[5m])))"
                }
              }
            ],
            "thresholds": [],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 4,
        "yPos": 36,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Elasticsearch search thread pool: queued and rejected",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "queued node=${metric.labels.name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (name)(elasticsearch_thread_pool_queue_count{cluster=\"${CLUSTER}\", type=\"search\"})"
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y2",
                "legendTemplate": "rejected/s node=${metric.labels.name}",
                "timeSeriesQuery": {
                  "prometheusQuery": "sum by (name)(rate(elasticsearch_thread_pool_rejected_count{cluster=\"${CLUSTER}\", type=\"search\"}[5m]))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 0.001,
                "label": "expected: no rejections",
                "targetAxis": "Y2"
              }
            ],
            "yAxis": {
              "label": "queued tasks",
              "scale": "LINEAR"
            },
            "y2Axis": {
              "label": "rejected / s",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 8,
        "yPos": 36,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Elasticsearch mean search latency, data nodes",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "mean search latency",
                "timeSeriesQuery": {
                  "prometheusQuery": "1000 * sum(rate(elasticsearch_indices_search_query_time_seconds{cluster=\"${CLUSTER}\", es_data_node=\"true\"}[30m]))\n     / sum(rate(elasticsearch_indices_search_query_total{cluster=\"${CLUSTER}\", es_data_node=\"true\"}[30m]))"
                }
              }
            ],
            "thresholds": [
              {
                "value": 10,
                "label": "warm-cache baseline (10 ms)",
                "targetAxis": "Y1"
              }
            ],
            "yAxis": {
              "label": "ms",
              "scale": "LINEAR"
            },
            "chartOptions": {
              "mode": "COLOR"
            }
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 44,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "5 — Elasticsearch page-cache residency",
          "sectionHeader": {
            "subtitle": "Whether Elasticsearch is serving reads from memory or from disk. Major page faults and device reads rise together once the working set has been evicted, which surfaces as slower queries in the previous section. Evictable memory is the cache budget those reads compete for.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 45,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Major page faults per second per data node (cache misses)",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "pod=${metric.labels.pod_name}",
                "timeSeriesQuery": {
