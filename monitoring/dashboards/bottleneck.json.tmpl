      {
        "xPos": 0,
        "yPos": 0,
        "width": 12,
        "height": 1,
        "widget": {
          "title": "1 — Load & UX",
          "sectionHeader": {
            "subtitle": "Is anyone hurting? The probe series is the real-user canary; load_test is the synthetic driver.",
            "dividerBelow": true
          }
        }
      },
      {
        "xPos": 0,
        "yPos": 1,
        "width": 4,
        "height": 8,
        "widget": {
          "title": "Renders/min by traffic",
          "xyChart": {
            "dataSets": [
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "success ${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"custom.googleapis.com/greenearth-api/feed.render.success_count\" resource.type=\"generic_task\" resource.label.\"namespace\"=\"${NAMESPACE}\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"traffic\""]
                    }
                  }
                }
              },
              {
                "plotType": "LINE",
                "targetAxis": "Y1",
                "legendTemplate": "failure ${metric.labels.traffic}",
                "timeSeriesQuery": {
                  "unitOverride": "1",
                  "timeSeriesFilter": {
                    "filter": "metric.type=\"custom.googleapis.com/greenearth-api/feed.render.failure_count\" resource.type=\"generic_task\" resource.label.\"namespace\"=\"${NAMESPACE}\"",
                    "aggregation": {
                      "alignmentPeriod": "60s",
                      "perSeriesAligner": "ALIGN_DELTA",
                      "crossSeriesReducer": "REDUCE_SUM",
                      "groupByFields": ["metric.label.\"traffic\""]
                    }
                  }
                }
              }
            ],
            "thresholds": [],
            "yAxis": {"label": "renders / min", "scale": "LINEAR"},
            "chartOptions": {"mode": "COLOR"}
          }
        }
      },
