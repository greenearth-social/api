########## Common Variables ##########

# Environment
export ENVIRONMENT=local

# Elasticsearch Configuration
export GE_ELASTICSEARCH_URL="https://localhost:9200"
export GE_ELASTICSEARCH_API_KEY="your-elasticsearch-api-key-here"

# GCP Configuration
export PROJECT_ID=my-gcp-project-id
export REGION=us-east1

########## Deployment Variables ########

export API_INSTANCES_MIN=1
export API_INSTANCES_MAX=10

########## Fast API Variables ##########

export API_KEY="your-fast-api-client-key-here"

########## Feed Publishing Variables ##########

# DID of the feed generator service (used by scripts/publish_feed.py)
# e.g. did:web:your-subdomain.ngrok.dev  or  did:web:your-domain.example.com
export GE_FEED_GENERATOR_DID="did:web:your-subdomain.ngrok.dev"

# Optional local overrides for repository-managed public feed pins. The
# deployment script publishes/reuses these posts and sets the values itself.
export GE_PINNED_POST_YOUR_FEED_URI=""
export GE_PINNED_POST_BEST_OF_FRIENDS_URI=""
export GE_PINNED_POST_RANDOM_URI=""

# Bluesky app password for the account that publishes the feed records
export GE_BSKY_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Secret used to HMAC-sign the feedContext tokens embedded in feed skeletons and
# verified when interactions come back via app.bsky.feed.sendInteractions.
# REQUIRED: the server refuses to start without it. Use a high-entropy random
# string and keep it identical across all instances in a given environment.
export GE_FEED_CONTEXT_SECRET="change-me-to-a-long-random-string"

########## Firestore Variables ##########

# To use the Firestore emulator for local development, set this to the
# emulator's host:port (e.g. 127.0.0.1:8080). Leave unset for production.
export GE_FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"

# Firestore project ID. The canonical emulator runs from the frontend repo and
# uses this namespace. GE_FIRESTORE_EMULATOR_HOST keeps all traffic local.
export GE_FIRESTORE_PROJECT="greenearth-471522"

########## Inference Variables ##########

# Optional explicit override. In stage/prod Cloud Run deploys, the API deploy script
# now defaults to mapped domains when this is unset:
#   stage -> https://inference-stage.greenearth.social
#   prod  -> https://inference.greenearth.social
# Keep this set in local development when you want to call a local inference service.
export GE_INFERENCE_BASE_URL=""
export GE_INFERENCE_DOMAIN="inference-stage.greenearth.social"
export GE_ENABLE_INFERENCE_DOMAIN_MAPPING=true
export GE_INFERENCE_API_KEY="inference-service-api-key-here"

########## Debugging Variables ##########

# Set GE_TIMING_LOGS to "1" to enable logging of timing data for various operations in the API.
export GE_TIMING_LOGS=""

# Set GE_PROFILE to "1" to enable profiling of the API. Results will be stored in the
# "profiles" directory.
export GE_PROFILE=""

# Set a threshold (in milliseconds) for logging slow Elasticsearch queries. Queries that exceed
# this threshold will have their details logged for further analysis.
export GE_SLOW_ES_THRESHOLD_MS=1000

########## Metrics Variables ##########

# Service name used as a label in GCP Cloud Monitoring custom metrics.
export GE_SERVICE_NAME="greenearth-api"

# How often (in seconds) to flush metrics to Cloud Monitoring.
export GE_METRICS_EXPORT_INTERVAL_SEC="60"

########## Followed-Users Cache ##########

# Per-user cache of Bluesky follow lists (issue #83). Jetstream ingest keeps
# entries current; these knobs only govern the backstop refresh.

# Age at which an entry is refreshed in the background (default 6 hours).
export GE_FOLLOWS_CACHE_TTL_SEC="21600"

# Budget for a background follow walk. Larger than the request-path clamp
# because nothing is waiting on it.
export GE_FOLLOWS_REFRESH_TIMEOUT_SEC="15"

# How long one instance may hold the refresh lease before another may retry.
export GE_FOLLOWS_CACHE_LEASE_SEC="30"

# Quiet period after a failed refresh, so a user whose follows cannot be
# fetched does not spawn a refresh task on every request.
export GE_FOLLOWS_CACHE_RETRY_COOLDOWN_SEC="60"

# How often one process samples population health (how many cached users are
# incomplete or stale) and reports it as gauges. Runs deferred, off the
# request path.
export GE_FOLLOWS_CACHE_SWEEP_SEC="300"
